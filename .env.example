# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
# Dapatkan nilai ini dari Project Settings > API di dashboard Supabase Anda.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Server-side admin key (JANGAN pernah diekspos ke client / browser).
# Diperlukan untuk User Management (sinkronisasi & hard delete ke Supabase Authentication).
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
